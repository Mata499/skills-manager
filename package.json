{
  "name": "dsh-project-skills-manager",
  "version": "0.1.6",
  "description": "Project-scoped skill visibility for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/implementation.md",
    "docs/dsh-integration-research.md",
    "docs/overlay-verification.md",
    "GLOSSARY.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "test:registry": "node tests/fixtures/dsh/verify.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
